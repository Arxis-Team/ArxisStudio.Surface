<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:surface="https://github.com/Arxis-Team/ArxisStudio.Surface"
        xmlns:machine="clr-namespace:Nodes.StateMachine.Machine"
        xmlns:nodes="clr-namespace:ArxisStudio.Surface.Nodes;assembly=ArxisStudio.Surface.Nodes"
        x:Class="Nodes.StateMachine.MainWindow"
        x:DataType="machine:MachineDocument"
        Title="Машина состояний — ArxisStudio.Surface.Nodes"
        Width="1440" Height="840"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!--
            Запущенная машина — как отладка State Machine в Unreal: активное состояние в янтарной
            рамке, след покинутого состояния и сработавшего перехода — рамка тоньше и прозрачнее, и он
            гаснет. Класс контейнеру ставит окно по MachineNode.Look. Селектор с классом — триггер стиля,
            и он сильнее значения, поставленного шаблоном карточки.
        -->
        <Style Selector="surface|Node.active /template/ Border#PART_Card">
            <Setter Property="BorderBrush" Value="#FFB300" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style Selector="surface|Node.trace /template/ Border#PART_Card">
            <Setter Property="BorderBrush" Value="#99FFB300" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBlock.run">
            <Setter Property="Foreground" Value="#FFB300" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!--
            Панель в два ряда: вверху — запуск, отладка потока и правка; внизу — подсказка. В один ряд
            подсказка сжималась в четыре строки.
        -->
        <StackPanel DockPanel.Dock="Top" Margin="12,8" Spacing="6">
            <StackPanel.Styles>
                <Style Selector="StackPanel.bar > :is(Control)">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="Border.divider">
                    <Setter Property="Width" Value="1" />
                    <Setter Property="Height" Value="22" />
                    <Setter Property="Margin" Value="6,0" />
                    <Setter Property="Background" Value="#33FFFFFF" />
                </Style>
            </StackPanel.Styles>
            <StackPanel Classes="bar" Orientation="Horizontal" Spacing="8">
                <Button x:Name="RunButton" Classes="accent" Content="▶ Запустить" Click="OnRunClick" />
                <CheckBox x:Name="NetworkBox" Content="Сеть" IsChecked="True" />
                <Border Classes="divider" />
                <!--
                    Отладка потока (ADR 0014 библиотеки): импульсы по сработавшим проводам и маркеры
                    направления. Оба выключаются, не теряя вида, — чтобы не отвлекали, пока проверяют само
                    приложение.
                -->
                <CheckBox Content="Импульсы" IsChecked="{Binding #Editor.IsLinkPulseEnabled}"
                          ToolTip.Tip="Пузыри и свечение по проводу сработавшего перехода" />
                <ComboBox x:Name="PulseShapeBox" SelectedIndex="0"
                          ToolTip.Tip="Фигура импульса">
                    <ComboBoxItem Content="● Пузыри" Tag="{x:Static nodes:LinkShape.Circle}" />
                    <ComboBoxItem Content="▶ Стрелки" Tag="{x:Static nodes:LinkShape.Arrow}" />
                    <ComboBoxItem Content="◆ Ромбы" Tag="{x:Static nodes:LinkShape.Diamond}" />
                </ComboBox>
                <CheckBox Content="Маркеры" IsChecked="{Binding #Editor.AreLinkMarkersVisible}"
                          ToolTip.Tip="Фигура направления посередине каждого провода" />
                <ComboBox x:Name="MarkerShapeBox" SelectedIndex="0"
                          ToolTip.Tip="Фигура маркера">
                    <ComboBoxItem Content="▶ Стрелка" Tag="{x:Static nodes:LinkShape.Arrow}" />
                    <ComboBoxItem Content="› Шеврон" Tag="{x:Static nodes:LinkShape.Chevron}" />
                    <ComboBoxItem Content="◆ Ромб" Tag="{x:Static nodes:LinkShape.Diamond}" />
                    <ComboBoxItem Content="■ Квадрат" Tag="{x:Static nodes:LinkShape.Square}" />
                </ComboBox>
                <Border Classes="divider" />
                <Button Content="Пример" Click="OnExampleClick" />
                <Button Content="Показать всё" Click="OnFitClick" />
                <Button x:Name="UndoButton" Content="Отменить" Click="OnUndoClick" />
                <Button x:Name="RedoButton" Content="Повторить" Click="OnRedoClick" />
                <TextBlock x:Name="ZoomText" Margin="8,0,0,0" Opacity="0.7" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                       Text="Правая кнопка по холсту — новое состояние, переход, вход · по узлу — экран, условие, начальное, удалить · от порта — связь · двойной щелчок по проводу — узел перенаправления · Delete — удалить" />
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="12,6" Opacity="0.7" />

        <!-- Приложение, которым управляет машина, и журнал переходов. -->
        <Border DockPanel.Dock="Right" Width="380" BorderThickness="1,0,0,0" BorderBrush="#33FFFFFF">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="16,12,16,0" Text="Приложение" Opacity="0.7" />
                <DockPanel DockPanel.Dock="Bottom" Height="240">
                    <TextBlock DockPanel.Dock="Top" Margin="16,8" Text="Журнал" Opacity="0.7" />
                    <ListBox x:Name="LogList" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <Border x:Name="PreviewFrame" Margin="12" CornerRadius="8" BorderThickness="1" BorderBrush="#33FFFFFF" ClipToBounds="True" />
            </DockPanel>
        </Border>

        <Grid>
            <surface:NodeEditor x:Name="Editor"
                                ItemsSource="{Binding Nodes}"
                                ItemLocationBinding="{Binding Location}"
                                ItemHeaderBinding="{Binding Title}"
                                ItemAccentBinding="{Binding Accent}"
                                EstimatedItemSize="178,76"
                                Links="{Binding Links}"
                                LinkSourceBinding="{Binding From}"
                                LinkTargetBinding="{Binding To}"
                                LinkStrokeBinding="{Binding Color}"
                                PortNodeBinding="{Binding Node, DataType={x:Type machine:FlowPort}}">
                <!-- Шаблоны — от частного к общему: узел перенаправления, переход и состояние — тоже MachineNode. -->
                <surface:NodeEditor.DataTemplates>
                    <DataTemplate x:DataType="machine:RerouteNode">
                        <surface:Reroute Input="{Binding Inputs[0]}" Output="{Binding Outputs[0]}" />
                    </DataTemplate>

                    <!-- Переход: условие — название узла; в теле — штырьки и «сработал» на запущенной машине. -->
                    <DataTemplate x:DataType="machine:TransitionNode">
                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="140">
                            <surface:Port Direction="Input" Data="{Binding Inputs[0]}" />
                            <TextBlock Grid.Column="1" Classes="run" Text="{Binding RunText}" IsVisible="{Binding HasRunText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                            <surface:Port Grid.Column="2" Direction="Output" Data="{Binding Outputs[0]}" />
                        </Grid>
                    </DataTemplate>

                    <!-- Состояние: порты, экран и время в состоянии на запущенной машине. -->
                    <DataTemplate x:DataType="machine:StateNode">
                        <StackPanel MinWidth="170">
                            <Grid ColumnDefinitions="*,*">
                                <surface:Port Direction="Input" Data="{Binding Inputs[0]}" Content="{Binding Inputs[0].Name}" />
                                <surface:Port Grid.Column="1" Direction="Output" Data="{Binding Outputs[0]}" Content="{Binding Outputs[0].Name}" />
                            </Grid>
                            <TextBlock Text="{Binding ScreenText}" Margin="10,2,10,4" Opacity="0.7" FontSize="12" />
                            <TextBlock Classes="run" Text="{Binding RunText}" IsVisible="{Binding HasRunText}" Margin="10,0,10,6" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>

                    <!-- Вход и любое состояние: только выход. -->
                    <DataTemplate x:DataType="machine:MachineNode">
                        <ItemsControl ItemsSource="{Binding Outputs}" MinWidth="150">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="machine:FlowPort">
                                    <surface:Port Direction="Output" Data="{Binding}" Content="{Binding Name}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </surface:NodeEditor.DataTemplates>
            </surface:NodeEditor>

            <surface:SurfaceMinimap Editor="{Binding #Editor}"
                                    Width="220" Height="150"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="12" />
        </Grid>
    </DockPanel>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UiDesigner.Demo.Views.Screens.AddDeviceDialogView">

    <!-- Диалог. Корень — Grid: положением полей распоряжается сетка,
         поэтому перетаскивание им недоступно, а размер меняется. -->
    <ThemeVariantScope RequestedThemeVariant="Light">
    <Border Background="#FFFFFF" BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="10" Padding="20">
        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Новое устройство"
                       FontSize="16" FontWeight="SemiBold" Foreground="#16191D" Margin="0,0,0,18" />

            <TextBlock Grid.Row="1" Text="Название" FontSize="11" Foreground="#667085"
                       VerticalAlignment="Center" Margin="0,0,12,10" />
            <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="Например, торшер"
                     Background="#F4F6F9" Foreground="#16191D" BorderBrush="#DCE1E8"
                     CornerRadius="7" Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Text="Тип" FontSize="11" Foreground="#667085"
                       VerticalAlignment="Center" Margin="0,0,12,10" />
            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                      SelectedIndex="0" Background="#F4F6F9" Foreground="#16191D"
                      BorderBrush="#DCE1E8" CornerRadius="7" Margin="0,0,0,10">
                <ComboBoxItem Content="Освещение" />
                <ComboBoxItem Content="Розетка" />
                <ComboBoxItem Content="Датчик" />
            </ComboBox>

            <TextBlock Grid.Row="3" Text="Комната" FontSize="11" Foreground="#667085"
                       VerticalAlignment="Center" Margin="0,0,12,10" />
            <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                      SelectedIndex="0" Background="#F4F6F9" Foreground="#16191D"
                      BorderBrush="#DCE1E8" CornerRadius="7" Margin="0,0,0,10">
                <ComboBoxItem Content="Гостиная" />
                <ComboBoxItem Content="Спальня" />
                <ComboBoxItem Content="Кухня" />
            </ComboBox>

            <CheckBox Grid.Row="4" Grid.Column="1" Content="Добавить на главный экран"
                      Foreground="#667085" IsChecked="True" VerticalAlignment="Top" />

            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8">
                <Button Content="Отмена" Background="#F4F6F9" Foreground="#667085"
                        BorderBrush="#DCE1E8" CornerRadius="7" Padding="16,7" />
                <Button Content="Добавить" Background="#2F6FED" Foreground="#FFFFFF"
                        BorderThickness="0" CornerRadius="7" Padding="16,7" />
            </StackPanel>

        </Grid>
    </Border>
    </ThemeVariantScope>
</UserControl>

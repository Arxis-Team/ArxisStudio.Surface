<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Акцент макета. Fluent берёт его из системного, а системный у каждой
        машины свой — на макете цвет обязан быть заданным, иначе переключатели
        и слайдеры красятся во что придётся и спорят с остальной палитрой.
    -->
    <Color x:Key="SystemAccentColor">#2F6FED</Color>
    <Color x:Key="SystemAccentColorLight1">#5A8DF2</Color>
    <Color x:Key="SystemAccentColorLight2">#85AAF6</Color>
    <Color x:Key="SystemAccentColorLight3">#B0C8FA</Color>
    <Color x:Key="SystemAccentColorDark1">#2559C4</Color>
    <Color x:Key="SystemAccentColorDark2">#1C449B</Color>
    <Color x:Key="SystemAccentColorDark3">#132F72</Color>

</ResourceDictionary>

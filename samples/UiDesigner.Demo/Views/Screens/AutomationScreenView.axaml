<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UiDesigner.Demo.Views.Screens.AutomationScreenView">

    <!-- Редактор сценария. Корень — DockPanel: положение задаётся стороной
         прикрепления, поэтому координаты недоступны, а размер меняется. -->
    <ThemeVariantScope RequestedThemeVariant="Light">
    <Border Background="#FFFFFF" BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="10" Padding="18">
        <DockPanel LastChildFill="True">

            <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,14">
                <TextBlock Text="Сценарий «Ушёл из дома»" FontSize="15" FontWeight="SemiBold"
                           Foreground="#16191D" />
                <TextBlock Text="Срабатывает при уходе последнего жильца" FontSize="11" Foreground="#667085" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Проверить" Background="#F4F6F9" Foreground="#667085"
                        BorderBrush="#DCE1E8" CornerRadius="7" Padding="14,6" />
                <Button Content="Сохранить" Background="#2F6FED" Foreground="#FFFFFF"
                        BorderThickness="0" CornerRadius="7" Padding="14,6" />
            </StackPanel>

            <StackPanel Spacing="8">

                <Border Background="#F4F6F9" BorderBrush="#DCE1E8" BorderThickness="1"
                        CornerRadius="9" Padding="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Background="#E8F0FE" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="ЕСЛИ" FontSize="10" FontWeight="SemiBold" Foreground="#1A56DB" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="никого нет дома дольше 10 минут"
                                   FontSize="12" Foreground="#16191D" VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <Border Background="#F4F6F9" BorderBrush="#DCE1E8" BorderThickness="1"
                        CornerRadius="9" Padding="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Background="#E6F5EC" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="ТО" FontSize="10" FontWeight="SemiBold" Foreground="#14804A" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="выключить свет во всех комнатах"
                                   FontSize="12" Foreground="#16191D" VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <Border Background="#F4F6F9" BorderBrush="#DCE1E8" BorderThickness="1"
                        CornerRadius="9" Padding="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Background="#E6F5EC" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="ТО" FontSize="10" FontWeight="SemiBold" Foreground="#14804A" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="снизить температуру до 18°"
                                   FontSize="12" Foreground="#16191D" VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <Button Content="+ Добавить действие" HorizontalAlignment="Left"
                        Background="Transparent" Foreground="#2F6FED" BorderThickness="0"
                        Padding="0,6" />

            </StackPanel>
        </DockPanel>
    </Border>
    </ThemeVariantScope>
</UserControl>

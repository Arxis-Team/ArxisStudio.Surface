<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UiDesigner.Demo.Views.Screens.ComponentLibraryView">

    <!-- Библиотека контролов, из которых собраны экраны.
         Корень — WrapPanel: положение задаёт поток, значит перестановка. -->
    <ThemeVariantScope RequestedThemeVariant="Light">
    <Border Background="#FFFFFF" BorderBrush="#DCE1E8" BorderThickness="1" CornerRadius="10" Padding="18">
        <StackPanel Spacing="14">

            <TextBlock Text="Компоненты" FontSize="14" FontWeight="SemiBold" Foreground="#16191D" />

            <WrapPanel Orientation="Horizontal" ItemWidth="220" ItemHeight="72">

                <Border Background="#F4F6F9" BorderBrush="#DCE1E8" BorderThickness="1"
                        CornerRadius="9" Padding="12" Margin="0,0,10,10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Переключатель" FontSize="12" Foreground="#16191D" />
                            <TextBlock Text="устройство вкл/выкл" FontSize="10" Foreground="#667085" />
                        </StackPanel>
                        <ToggleSwitch OnContent="" OffContent="" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Background="#F4F6F9" BorderBrush="#DCE1E8" BorderThickness="1"
                        CornerRadius="9" Padding="12" Margin="0,0,10,10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Яркость" FontSize="12" Foreground="#16191D" />
                        <Slider Value="70" Minimum="0" Maximum="100" />
                    </StackPanel>
                </Border>

                <Border Background="#F4F6F9" BorderBrush="#DCE1E8" BorderThickness="1"
                        CornerRadius="9" Padding="12" Margin="0,0,10,10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Статус" FontSize="12" Foreground="#16191D" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Background="#E6F5EC" CornerRadius="10" Padding="9,3">
                                <TextBlock Text="онлайн" FontSize="10" Foreground="#14804A" />
                            </Border>
                            <Border Background="#FDF3E3" CornerRadius="10" Padding="9,3">
                                <TextBlock Text="батарея" FontSize="10" Foreground="#B45309" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#F4F6F9" BorderBrush="#DCE1E8" BorderThickness="1"
                        CornerRadius="9" Padding="12" Margin="0,0,10,10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Показание датчика" FontSize="12" Foreground="#16191D" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="46" FontSize="18" FontWeight="SemiBold" Foreground="#16191D" />
                            <TextBlock Text="% влажности" FontSize="10" Foreground="#667085"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </StackPanel>
    </Border>
    </ThemeVariantScope>
</UserControl>

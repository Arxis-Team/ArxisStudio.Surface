<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:UiDesigner.Demo.Views"
             xmlns:vm="using:UiDesigner.Demo.ViewModels"
             x:Class="UiDesigner.Demo.Views.PropertiesPanel"
             x:DataType="views:PropertiesPanel"
             Width="272">

    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Пометка «вне отмены»: правка идёт прямо в свойство контрола, а редактор
             распоряжается только геометрией, порядком и группами. -->
        <Style Selector="TextBlock.aside">
            <Setter Property="Foreground" Value="#6E7480" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#8A8F98" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style Selector="TextBox.field">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Background" Value="#2A2C31" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="TextBox.field:disabled">
            <Setter Property="Background" Value="#232428" />
            <Setter Property="Foreground" Value="#5A5F68" />
        </Style>

        <Style Selector="ComboBox.field">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="#2A2C31" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Button.orderBtn">
            <Setter Property="Background" Value="#2A2C31" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.orderBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!--
            Подсказки о жестах говорят тем же языком, что остальная панель: плашка
            клавиши — это фон поля, описание — цвет строки списка. Своя палитра
            досталась им от плавающей карточки и читалась как чужая вставка.
        -->
        <Style Selector="Border.hints">
            <Setter Property="BorderBrush" Value="#2C2F36" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="10,10,10,12" />
        </Style>

        <Style Selector="Border.hintKey">
            <Setter Property="Width" Value="92" />
            <Setter Property="Background" Value="#2A2C31" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Border.hintKey > TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#B7BCC5" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="Border.group">
            <Setter Property="BorderBrush" Value="#2C2F36" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,10,10,12" />
        </Style>
    </UserControl.Styles>

    <Border Background="#1E1E1E" BorderBrush="#3E4451" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*,Auto">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,8,10,8">
                <TextBlock Text="Свойства" Foreground="#E6E6E6" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="TargetName" Classes="aside" />
            </Grid>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Sections">

                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Положение и размер" />
                            <Grid ColumnDefinitions="Auto,*,12,Auto,*" ColumnSpacing="0">
                                <TextBlock Classes="label" Text="X" />
                                <TextBox Grid.Column="1" x:Name="PosX" Classes="field" />
                                <TextBlock Grid.Column="3" Classes="label" Text="Y" />
                                <TextBox Grid.Column="4" x:Name="PosY" Classes="field" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,12,Auto,*" ColumnSpacing="0">
                                <TextBlock Classes="label" Text="W" />
                                <TextBox Grid.Column="1" x:Name="SizeW" Classes="field" />
                                <TextBlock Grid.Column="3" Classes="label" Text="H" />
                                <TextBox Grid.Column="4" x:Name="SizeH" Classes="field" />
                            </Grid>
                            <TextBlock x:Name="PlacementNote" Classes="aside" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="Раскладка" />
                                <TextBlock Grid.Column="1" Classes="aside" Text="вне отмены" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="label" Text="Margin" />
                                <TextBox Grid.Column="1" x:Name="MarginBox" Classes="field" />
                            </Grid>
                            <Grid ColumnDefinitions="*,8,*">
                                <ComboBox x:Name="HAlign" Classes="field" HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Column="2" x:Name="VAlign" Classes="field" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="Оформление" />
                                <TextBlock Grid.Column="1" Classes="aside" Text="вне отмены" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,12,Auto,*">
                                <TextBlock Classes="label" Text="Прозр." />
                                <TextBox Grid.Column="1" x:Name="OpacityBox" Classes="field" />
                                <TextBlock Grid.Column="3" Classes="label" Text="Скругл." />
                                <TextBox Grid.Column="4" x:Name="CornerBox" Classes="field" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="label" Text="Фон" />
                                <TextBox Grid.Column="1" x:Name="BackgroundBox" Classes="field" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="group">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section" Text="Порядок перекрытия" />
                            <!-- Сетка, а не строка: четыре подписи в одну строку не влезают
                                 в ширину панели, и последняя кнопка обрезалась. -->
                            <Grid ColumnDefinitions="*,4,*" RowDefinitions="Auto,4,Auto">
                                <Button Classes="orderBtn" Content="На передний" Click="BringToFront_OnClick"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Grid.Column="2" Classes="orderBtn" Content="На задний" Click="SendToBack_OnClick"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Grid.Row="2" Classes="orderBtn" Content="Вперёд" Click="BringForward_OnClick"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Grid.Row="2" Grid.Column="2" Classes="orderBtn" Content="Назад" Click="SendBackward_OnClick"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="group" BorderThickness="0">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="Правка" />
                                <TextBlock Grid.Column="1" Classes="aside" Text="вне отмены" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="label" Text="Двигать" />
                                <ComboBox Grid.Column="1" x:Name="MovePolicyBox" Classes="field"
                                          HorizontalAlignment="Stretch" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="label" Text="Размер" />
                                <ComboBox Grid.Column="1" x:Name="ResizePolicyBox" Classes="field"
                                          HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!--
                Подсказки о жестах стоят ниже свойств и вне блока Sections: тот гаснет,
                когда ничего не выбрано, а жесты читают как раз тогда, когда ещё не знают,
                как что-нибудь выбрать.
            -->
            <Border Grid.Row="2" Classes="hints">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="section" Margin="0" Text="Жесты редактора" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghostBtn" Click="ToggleGestures_OnClick"
                                Content="⌄" IsVisible="{Binding IsGestureHelpExpanded}"
                                ToolTip.Tip="Свернуть подсказки" />
                        <Button Grid.Column="1" Classes="ghostBtn" Click="ToggleGestures_OnClick"
                                Content="›" IsVisible="{Binding !IsGestureHelpExpanded}"
                                ToolTip.Tip="Развернуть подсказки" />
                    </Grid>

                    <TextBlock Classes="aside" Text="Показать подсказки"
                               IsVisible="{Binding !IsGestureHelpExpanded}" />

                    <!--
                        Список идёт из вью-модели, а не рукописной сеткой: раньше каждая
                        строка стоила восемнадцати строк разметки, и список разошёлся
                        с настоящими жестами — дописать в него было дороже, чем не дописать.
                    -->
                    <ScrollViewer IsVisible="{Binding IsGestureHelpExpanded}"
                                  MaxHeight="300"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible">
                        <ItemsControl ItemsSource="{Binding Gestures}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:GestureHint">
                                    <!-- Отступ справа под полосу прокрутки: без него
                                         описания обрезались ровно на её ширину. -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,6,0">
                                        <!--
                                            Ширина плашки задана, а не выведена из текста:
                                            иначе столбец описаний ехал бы у каждой строки
                                            по-своему и читать список было бы нечем.
                                        -->
                                        <!-- Цвета задают классы, а не атрибуты: локальное
                                             значение в Avalonia сильнее любого стиля. -->
                                        <Border Classes="hintKey">
                                            <TextBlock Text="{Binding Keys}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Description}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

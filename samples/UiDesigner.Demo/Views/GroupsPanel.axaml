<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UiDesigner.Demo.ViewModels"
             xmlns:views="using:UiDesigner.Demo.Views"
             x:Class="UiDesigner.Demo.Views.GroupsPanel"
             x:DataType="views:GroupsPanel"
             Width="248">

    <UserControl.Styles>
        <Style Selector="Button.panelBtn">
            <Setter Property="Background" Value="#2A2C31" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.panelBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.panelBtn:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#232428" />
            <Setter Property="Foreground" Value="#5A5F68" />
        </Style>

        <!-- Обновление стоит в шапке и кнопкой не выглядит: это не действие над макетом. -->
        <Style Selector="Button.ghostBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="#8A8F98" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.ghostBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Правка имени на месте: рамка вместо строки, без собственного фона списка. -->
        <Style Selector="TextBox.rename">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="16" />
            <Setter Property="Margin" Value="0,-1,8,-1" />
            <Setter Property="Background" Value="#15171B" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#4C8DFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--
            Строка: наведение и выбор. Выбор приходит от редактора, а не от списка.
            Фон задаётся стилем, а не атрибутом на самом Border: локальное значение
            в Avalonia сильнее любого стиля, и подсветка молча не появлялась бы.
        -->
        <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>
        <Style Selector="Border.row.selected">
            <Setter Property="Background" Value="#2E3547" />
        </Style>
    </UserControl.Styles>

    <Border Background="#1E1E1E" BorderBrush="#3E4451" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,8,6,8">
                <TextBlock Text="Группы" Foreground="#E6E6E6" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghostBtn" Content="⟳"
                        Click="Refresh_OnClick"
                        ToolTip.Tip="Перечитать группы у редактора" />
            </Grid>

            <!--
                Кнопки работают с выделением редактора, а не со строками панели:
                группировать можно ровно то, что выбрано, и панель не заводит
                собственного понятия выбора.
            -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="8,0,8,8">
                <Button Classes="panelBtn" Content="Группировать"
                        IsEnabled="{Binding CanGroup}" Click="Group_OnClick" />
                <Button Classes="panelBtn" Content="Разгруппировать"
                        IsEnabled="{Binding CanUngroup}" Click="Ungroup_OnClick" />
            </StackPanel>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Nodes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupNode">
                            <Border Classes="row"
                                    Classes.selected="{Binding IsSelected}"
                                    Padding="0,3"
                                    Cursor="Hand"
                                    PointerPressed="Row_OnPointerPressed">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="{Binding Indent}">
                                    <TextBlock Text="{Binding Chevron}" Width="14" FontSize="11"
                                               Foreground="#8A8F98" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Glyph}" Width="18" FontSize="11"
                                               Foreground="#8A8F98" VerticalAlignment="Center" />
                                    <Panel Grid.Column="2">
                                        <TextBlock Text="{Binding Title}" FontSize="11"
                                                   IsVisible="{Binding IsNotEditing}"
                                                   Foreground="{Binding TitleBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBox Classes="rename"
                                                 Text="{Binding EditText, Mode=TwoWay}"
                                                 IsVisible="{Binding IsEditing}"
                                                 AttachedToVisualTree="EditBox_OnAttached"
                                                 KeyDown="EditBox_OnKeyDown"
                                                 LostFocus="EditBox_OnLostFocus" />
                                    </Panel>
                                    <TextBlock Grid.Column="3" Text="{Binding Note}" FontSize="10"
                                               Foreground="#6E7480" Margin="6,0,10,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

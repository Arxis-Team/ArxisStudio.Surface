<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:surface="https://github.com/Arxis-Team/ArxisStudio.Surface"
        xmlns:demo="clr-namespace:Nodes.Demo"
        x:Class="Nodes.Demo.MainWindow"
        x:DataType="demo:GraphDocument"
        Title="Редактор узлов — ArxisStudio.Surface.Nodes"
        Width="1200" Height="720"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="ZoomText" VerticalAlignment="Center" Opacity="0.7" />
                <Button x:Name="ImageGraphButton" Content="Изображение" Click="OnImageGraphClick" />
                <Button x:Name="StateMachineButton" Content="Машина состояний" Click="OnStateMachineClick" />
                <Button x:Name="LargeGraphButton" Content="10 000 узлов" Click="OnLargeGraphClick" />
                <Button x:Name="FitButton" Content="Показать всё" Click="OnFitClick" />
                <Button x:Name="UndoButton" Content="Отменить" Click="OnUndoClick" />
                <Button x:Name="RedoButton" Content="Повторить" Click="OnRedoClick" />
            </StackPanel>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.7"
                       Text="От порта — новая связь · щелчок по связи — выбор, Delete — удалить · протяжка связи — перецепить ближний конец · двойной щелчок по связи — излом · Alt + протяжка — разрез · Esc — отмена" />
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="12,6" Opacity="0.7" />

        <Grid>
            <!--
                Положение узла и концы связи — привязками к элементу коллекции, как DisplayMemberBinding:
                тип данных для них компилятор берёт у ItemsSource и Links. С ItemLocationBinding панель
                держит контейнеры только у видимых узлов (ADR 0007): у свёрнутого положение — в модели,
                размер — измеренный при показе, а до первого показа — EstimatedItemSize, размер узла с
                двумя входами и выходом в теме библиотеки: такие строит «10 000 узлов». PortNodeBinding
                называет узел порта, и связь к ни разу не показанному узлу рисуется оценкой по его краю.
                Ниже 50 % узлы рисуются карточками без контейнеров (ADR 0008), и MinZoom опущен, чтобы
                граф на 10 000 узлов вошёл в окно целиком. Название узла — из ItemHeaderBinding, полоса
                под ним — цвет вида узла из ItemAccentBinding, провод — цвет типа порта из
                LinkStrokeBinding (ADR 0009): обычный узел и его карточка показывают одно и то же.
                Шаблоны узлов — по типу данных, от частного к общему: перевалка, переход и состояние машины
                состояний — тоже GraphNode, и шаблон узла изображения, стоящий раньше, взял бы их себе.
            -->
            <surface:NodeEditor x:Name="Editor"
                                ItemsSource="{Binding Nodes}"
                                ItemLocationBinding="{Binding Location}"
                                ItemHeaderBinding="{Binding Title}"
                                ItemAccentBinding="{Binding Accent}"
                                MinZoom="0.02"
                                EstimatedItemSize="178,76"
                                Links="{Binding Links}"
                                LinkSourceBinding="{Binding From}"
                                LinkTargetBinding="{Binding To}"
                                LinkStrokeBinding="{Binding Color}"
                                PortNodeBinding="{Binding Node, DataType={x:Type demo:GraphPort}}">
                <surface:NodeEditor.DataTemplates>
                    <DataTemplate x:DataType="demo:RerouteNode">
                        <surface:Reroute Input="{Binding Inputs[0]}" Output="{Binding Outputs[0]}" />
                    </DataTemplate>

                    <!-- Переход: условие — название узла, тело — только штырьки входа и выхода. -->
                    <DataTemplate x:DataType="demo:TransitionNode">
                        <Grid ColumnDefinitions="Auto,*,Auto" MinWidth="120">
                            <surface:Port Direction="Input" Data="{Binding Inputs[0]}" />
                            <surface:Port Grid.Column="2" Direction="Output" Data="{Binding Outputs[0]}" />
                        </Grid>
                    </DataTemplate>

                    <!-- Состояние: порты потока и клип анимации под ними. -->
                    <DataTemplate x:DataType="demo:StateNode">
                        <StackPanel MinWidth="160">
                            <Grid ColumnDefinitions="*,*">
                                <ItemsControl ItemsSource="{Binding Inputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="demo:GraphPort">
                                            <surface:Port Direction="Input" Data="{Binding}" Content="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Outputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="demo:GraphPort">
                                            <surface:Port Direction="Output" Data="{Binding}" Content="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <TextBlock Text="{Binding Clip, StringFormat='клип: {0}'}"
                                       IsVisible="{Binding Clip, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Margin="10,2,10,6" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>

                    <!--
                        Тело узла — порты; название и полосу узел рисует сам, из ItemHeaderBinding и
                        ItemAccentBinding (ADR 0009 библиотеки).
                    -->
                    <DataTemplate x:DataType="demo:GraphNode">
                        <StackPanel MinWidth="160">
                            <Grid ColumnDefinitions="*,*">
                                <ItemsControl ItemsSource="{Binding Inputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="demo:GraphPort">
                                            <surface:Port Direction="Input" Data="{Binding}" Content="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Outputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="demo:GraphPort">
                                            <surface:Port Direction="Output" Data="{Binding}" Content="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </surface:NodeEditor.DataTemplates>
            </surface:NodeEditor>

            <!-- Миникарта инструментов — поверх холста, в углу; связи на неё дорисовывает редактор узлов. -->
            <surface:SurfaceMinimap x:Name="Minimap"
                                    Editor="{Binding #Editor}"
                                    Width="220" Height="150"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="12" />
        </Grid>
    </DockPanel>
</Window>

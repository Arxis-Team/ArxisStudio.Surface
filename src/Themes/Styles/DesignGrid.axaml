<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:surface="clr-namespace:ArxisStudio.Surface">

    <!--
        Тема фоновой сетки. Все параметры вынесены в lightweight-ресурсы,
        поэтому шаг, плотность и палитру можно менять без копирования темы.
    -->
    <ControlTheme x:Key="{x:Type surface:DesignGrid}" TargetType="surface:DesignGrid">
        <Setter Property="Background" Value="{DynamicResource DesignEditor.Grid.BackgroundBrush}" />
        <Setter Property="LineBrush" Value="{DynamicResource DesignEditor.Grid.LineBrush}" />
        <Setter Property="MajorLineBrush" Value="{DynamicResource DesignEditor.Grid.MajorLineBrush}" />
        <Setter Property="CellSize" Value="{DynamicResource DesignEditor.Grid.CellSize}" />
        <Setter Property="MajorInterval" Value="{DynamicResource DesignEditor.Grid.MajorInterval}" />
        <Setter Property="LineThickness" Value="{DynamicResource DesignEditor.Grid.LineThickness}" />
        <Setter Property="MinCellSize" Value="{DynamicResource DesignEditor.Grid.MinCellSize}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </ControlTheme>

</ResourceDictionary>

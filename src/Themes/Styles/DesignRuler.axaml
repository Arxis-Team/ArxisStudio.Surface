<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:editing="clr-namespace:ArxisStudio.Surface.Editing">

    <!--
        Линейка не имеет шаблона: она рисует шкалу целиком в Render, как сетка
        и слой направляющих. Тема задаёт только размер и кисти.

        Толщина по умолчанию одна на обе ориентации, поэтому угол между линейками
        получается квадратным без отдельной настройки.
    -->
    <ControlTheme x:Key="{x:Type editing:DesignRuler}" TargetType="editing:DesignRuler">
        <Setter Property="Background" Value="{DynamicResource DesignEditor.Ruler.BackgroundBrush}" />
        <Setter Property="TickBrush" Value="{DynamicResource DesignEditor.Ruler.TickBrush}" />
        <Setter Property="LabelBrush" Value="{DynamicResource DesignEditor.Ruler.LabelBrush}" />
        <Setter Property="LabelFontSize" Value="{DynamicResource DesignEditor.Ruler.LabelFontSize}" />

        <Style Selector="^[Orientation=Horizontal]">
            <Setter Property="Height" Value="{DynamicResource DesignEditor.Ruler.Thickness}" />
            <Setter Property="Cursor" Value="{DynamicResource DesignEditor.Ruler.CursorHorizontal}" />
        </Style>

        <Style Selector="^[Orientation=Vertical]">
            <Setter Property="Width" Value="{DynamicResource DesignEditor.Ruler.Thickness}" />
            <Setter Property="Cursor" Value="{DynamicResource DesignEditor.Ruler.CursorVertical}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodes="clr-namespace:ArxisStudio.Surface.Nodes">

    <!-- Связь рисует себя сама; тема задаёт только перо. -->
    <ControlTheme x:Key="{x:Type nodes:Link}" TargetType="nodes:Link">
        <Setter Property="Stroke" Value="{DynamicResource NodeEditor.Link.Stroke}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource NodeEditor.Link.Thickness}" />

        <!-- Попадания связь не принимает, поэтому наведение она показывает :highlighted, а не :pointerover. -->
        <Style Selector="^:highlighted">
            <Setter Property="Stroke" Value="{DynamicResource NodeEditor.Link.HighlightedStroke}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Stroke" Value="{DynamicResource NodeEditor.Link.SelectedStroke}" />
        </Style>

        <!-- Перечёркнутая разрезом — цветом разреза, сильнее выбора: отпустят — её удалят. -->
        <Style Selector="^:cutting">
            <Setter Property="Stroke" Value="{DynamicResource NodeEditor.Cut.Stroke}" />
        </Style>

        <!-- Отцеплённая связь бледнеет: новую её форму рисует превью протяжки. -->
        <Style Selector="^:detaching">
            <Setter Property="Opacity" Value="{DynamicResource NodeEditor.Link.DetachingOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>

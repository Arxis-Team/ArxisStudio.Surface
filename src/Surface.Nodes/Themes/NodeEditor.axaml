<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:surface="clr-namespace:ArxisStudio.Surface;assembly=ArxisStudio.Surface"
                    xmlns:editing="clr-namespace:ArxisStudio.Surface.Editing;assembly=ArxisStudio.Surface.Editing"
                    xmlns:nodes="clr-namespace:ArxisStudio.Surface.Nodes">

    <surface:InverseScaleConverter x:Key="NodeEditor.InverseScaleConverter" />
    <surface:ScaleDoubleConverter x:Key="NodeEditor.ScaleDoubleConverter" />

    <!--
        Слои снизу вверх: сетка, связи, узлы, протягиваемая связь, рамка, направляющие. Связи —
        под узлами: узел, лёгший на связь, закрывает её, как на бумаге. Сетка и направляющие
        рисуют в экранных координатах и трансформации не получают — правило ядра; всё
        остальное лежит под ViewportTransform, в мировых координатах.
    -->
    <ControlTheme x:Key="{x:Type nodes:NodeEditor}" TargetType="nodes:NodeEditor">
        <Setter Property="Background" Value="{DynamicResource Surface.BackgroundBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid>
                        <surface:SurfaceGrid Name="PART_Grid"
                                            ViewportLocation="{TemplateBinding ViewportLocation}"
                                            ViewportZoom="{TemplateBinding ViewportZoom}"
                                            IsVisible="{TemplateBinding ShowGrid}" />

                        <!--
                            Связи в попадании не участвуют: по ним попадает редактор сам, с допуском
                            в пикселях экрана, и только там, где нажатие не взял ни один узел.
                        -->
                        <Canvas Name="PART_LinksLayer"
                                IsHitTestVisible="False"
                                RenderTransform="{TemplateBinding ViewportTransform}"
                                RenderTransformOrigin="0,0">
                            <nodes:LinksPresenter Name="PART_LinksPresenter"
                                                  ItemsSource="{TemplateBinding Links}" />
                        </Canvas>

                        <Canvas Name="PART_ItemsLayer"
                                RenderTransform="{TemplateBinding ViewportTransform}"
                                RenderTransformOrigin="0,0">
                            <ItemsPresenter Name="PART_ItemsPresenter">
                                <ItemsPresenter.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <surface:SurfacePanel Extent="{Binding ItemsExtent, Mode=OneWayToSource, RelativeSource={RelativeSource AncestorType=nodes:NodeEditor}}" />
                                    </ItemsPanelTemplate>
                                </ItemsPresenter.ItemsPanel>
                            </ItemsPresenter>
                        </Canvas>

                        <!-- Протягиваемая связь — над узлами: её тянут к порту, и узел её не закрывает. -->
                        <Canvas Name="PART_PendingLinkLayer"
                                IsHitTestVisible="False"
                                RenderTransform="{TemplateBinding ViewportTransform}"
                                RenderTransformOrigin="0,0">
                            <nodes:PendingLinkPreview Name="PART_PendingLink"
                                                      Stroke="{DynamicResource NodeEditor.PendingLink.Stroke}"
                                                      StrokeThickness="{DynamicResource NodeEditor.Link.Thickness}" />
                        </Canvas>

                        <!-- Разрез — поверх узлов: отрезок видно и там, где он идёт над узлом. -->
                        <Canvas Name="PART_CutLayer"
                                IsHitTestVisible="False"
                                RenderTransform="{TemplateBinding ViewportTransform}"
                                RenderTransformOrigin="0,0">
                            <nodes:LinkCutPreview Name="PART_CutLine"
                                                  Stroke="{DynamicResource NodeEditor.Cut.Stroke}"
                                                  StrokeThickness="{DynamicResource NodeEditor.Cut.Thickness}" />
                        </Canvas>

                        <Canvas Name="PART_InteractionOverlayLayer"
                                IsHitTestVisible="False"
                                RenderTransform="{TemplateBinding ViewportTransform}"
                                RenderTransformOrigin="0,0">
                            <Rectangle Name="PART_Marquee"
                                       Stroke="{DynamicResource Surface.MarqueeStrokeBrush}"
                                       StrokeThickness="{DynamicResource Surface.Selection.StrokeThickness}"
                                       Fill="{DynamicResource Surface.MarqueeFillBrush}"
                                       RenderTransform="{Binding ViewportZoom, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NodeEditor.InverseScaleConverter}}"
                                       RenderTransformOrigin="0,0"
                                       Canvas.Top="{Binding SelectedArea.Y, RelativeSource={RelativeSource TemplatedParent}}"
                                       Canvas.Left="{Binding SelectedArea.X, RelativeSource={RelativeSource TemplatedParent}}"
                                       IsVisible="{TemplateBinding IsSelecting}">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource NodeEditor.ScaleDoubleConverter}">
                                        <Binding Path="SelectedArea.Width" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ViewportZoom" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Rectangle.Width>
                                <Rectangle.Height>
                                    <MultiBinding Converter="{StaticResource NodeEditor.ScaleDoubleConverter}">
                                        <Binding Path="SelectedArea.Height" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ViewportZoom" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Rectangle.Height>
                            </Rectangle>
                        </Canvas>

                        <!--
                            Слою направляющих достаточно знать редактор: положение, масштаб и линии
                            он берёт у него сам, через присоединённые свойства привязки.
                        -->
                        <editing:SnapGuideLayer Name="PART_SnapGuideLayer"
                                                IsHitTestVisible="False"
                                                Editor="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                LineBrush="{DynamicResource Surface.SnapGuideBrush}"
                                                CentreLineBrush="{DynamicResource Surface.SnapGuide.CentreBrush}"
                                                SpacingBrush="{DynamicResource Surface.SpacingBrush}"
                                                UserGuideBrush="{DynamicResource Surface.UserGuideBrush}"
                                                LineDashStyle="{DynamicResource Surface.SnapGuide.DashStyle}"
                                                UserGuideDashStyle="{DynamicResource Surface.UserGuide.DashStyle}"
                                                LineThickness="{DynamicResource Surface.SnapGuide.Thickness}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>

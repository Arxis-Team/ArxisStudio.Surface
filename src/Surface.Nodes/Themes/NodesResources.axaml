<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Ресурсы редактора узлов. Ключи начинаются с NodeEditor: их переопределяют приложения,
        и имя ключа — часть контракта темы. Остальное шаблон берёт у ядра и инструментов.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NodeEditor.Node.Background" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NodeEditor.Node.BorderBrush" Color="#C9D0DA" />
            <SolidColorBrush x:Key="NodeEditor.Node.HoverBorderBrush" Color="#8A96A8" />
            <SolidColorBrush x:Key="NodeEditor.Node.SelectedBorderBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="NodeEditor.Node.Foreground" Color="#1F2328" />
            <SolidColorBrush x:Key="NodeEditor.Port.PinFill" Color="#FFFFFF" />
            <SolidColorBrush x:Key="NodeEditor.Port.PinStroke" Color="#5C6577" />
            <SolidColorBrush x:Key="NodeEditor.Port.ConnectedFill" Color="#5C6577" />
            <SolidColorBrush x:Key="NodeEditor.Link.Stroke" Color="#8A96A8" />
            <SolidColorBrush x:Key="NodeEditor.Link.HighlightedStroke" Color="#5C6577" />
            <SolidColorBrush x:Key="NodeEditor.Link.SelectedStroke" Color="#0F6CBD" />
            <SolidColorBrush x:Key="NodeEditor.PendingLink.Stroke" Color="#0F6CBD" />
            <SolidColorBrush x:Key="NodeEditor.Port.AcceptingStroke" Color="#1A7F37" />
            <SolidColorBrush x:Key="NodeEditor.Port.RefusingStroke" Color="#CF222E" />
            <SolidColorBrush x:Key="NodeEditor.Cut.Stroke" Color="#CF222E" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="NodeEditor.Node.Background" Color="#26292E" />
            <SolidColorBrush x:Key="NodeEditor.Node.BorderBrush" Color="#3E4451" />
            <SolidColorBrush x:Key="NodeEditor.Node.HoverBorderBrush" Color="#5C6577" />
            <SolidColorBrush x:Key="NodeEditor.Node.SelectedBorderBrush" Color="#1E90FF" />
            <SolidColorBrush x:Key="NodeEditor.Node.Foreground" Color="#E6E8EB" />
            <SolidColorBrush x:Key="NodeEditor.Port.PinFill" Color="#26292E" />
            <SolidColorBrush x:Key="NodeEditor.Port.PinStroke" Color="#8A96A8" />
            <SolidColorBrush x:Key="NodeEditor.Port.ConnectedFill" Color="#8A96A8" />
            <SolidColorBrush x:Key="NodeEditor.Link.Stroke" Color="#6E7A8C" />
            <SolidColorBrush x:Key="NodeEditor.Link.HighlightedStroke" Color="#A8B3C4" />
            <SolidColorBrush x:Key="NodeEditor.Link.SelectedStroke" Color="#1E90FF" />
            <SolidColorBrush x:Key="NodeEditor.PendingLink.Stroke" Color="#1E90FF" />
            <SolidColorBrush x:Key="NodeEditor.Port.AcceptingStroke" Color="#3FB950" />
            <SolidColorBrush x:Key="NodeEditor.Port.RefusingStroke" Color="#F85149" />
            <SolidColorBrush x:Key="NodeEditor.Cut.Stroke" Color="#F85149" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="NodeEditor.Node.BorderThickness">1</Thickness>
    <Thickness x:Key="NodeEditor.Node.SelectedBorderThickness">2</Thickness>
    <CornerRadius x:Key="NodeEditor.Node.CornerRadius">6</CornerRadius>
    <Thickness x:Key="NodeEditor.Node.Padding">8</Thickness>

    <x:Double x:Key="NodeEditor.Port.PinSize">10</x:Double>
    <x:Double x:Key="NodeEditor.Port.PinStrokeThickness">1.5</x:Double>
    <Thickness x:Key="NodeEditor.Port.PinMargin">4,2</Thickness>

    <x:Double x:Key="NodeEditor.Link.Thickness">2</x:Double>

    <x:Double x:Key="NodeEditor.Cut.Thickness">1.5</x:Double>

    <x:Double x:Key="NodeEditor.Reroute.Size">22</x:Double>
    <x:Double x:Key="NodeEditor.Reroute.RingThickness">1</x:Double>
    <x:Double x:Key="NodeEditor.Reroute.SelectedRingThickness">2</x:Double>
    <x:Double x:Key="NodeEditor.Link.DetachingOpacity">0.35</x:Double>

    <!-- Полоса заголовка упрощённого узла — высотой в строку заголовка карточки (ADR 0008). -->
    <x:Double x:Key="NodeEditor.Simplified.AccentHeight">24</x:Double>

    <!-- Толщина связи упрощённого вида, в пикселях экрана: тысячи связей толще сливаются. -->
    <x:Double x:Key="NodeEditor.Simplified.LinkThickness">1</x:Double>

</ResourceDictionary>

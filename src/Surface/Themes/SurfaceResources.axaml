<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Ресурсы ядра: фон поверхности, рамка выделения, сетка и карточки упрощённого вида.
        Здесь лежат lightweight styling resources, которые можно переопределять
        без копирования ControlTheme конкретных контролов. Ключи сохранили прежние
        имена (UiDesignerView.*): их переопределяют приложения, и имя ключа — часть
        контракта темы, а не указание на слой.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Surface.BackgroundBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="Surface.MarqueeStrokeBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="Surface.MarqueeFillBrush" Color="#190F6CBD" />

            <SolidColorBrush x:Key="Surface.Grid.BackgroundBrush" Color="#F5F7FA" />
            <SolidColorBrush x:Key="Surface.Grid.LineBrush" Color="#E2E6EC" />
            <SolidColorBrush x:Key="Surface.Grid.MajorLineBrush" Color="#C9D0DA" />

            <SolidColorBrush x:Key="SurfaceItem.SelectionBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="SurfaceItem.HoverBrush" Color="#660F6CBD" />

            <SolidColorBrush x:Key="Surface.Simplified.ItemFill" Color="#E4E8EE" />
            <SolidColorBrush x:Key="Surface.Simplified.ItemStroke" Color="#B8C1CD" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Surface.BackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="Surface.MarqueeStrokeBrush" Color="#1E90FF" />
            <SolidColorBrush x:Key="Surface.MarqueeFillBrush" Color="#1A1E90FF" />

            <SolidColorBrush x:Key="Surface.Grid.BackgroundBrush" Color="#141417" />
            <SolidColorBrush x:Key="Surface.Grid.LineBrush" Color="#26292E" />
            <SolidColorBrush x:Key="Surface.Grid.MajorLineBrush" Color="#3E4451" />

            <SolidColorBrush x:Key="SurfaceItem.SelectionBrush" Color="#1E90FF" />
            <SolidColorBrush x:Key="SurfaceItem.HoverBrush" Color="#661E90FF" />

            <SolidColorBrush x:Key="Surface.Simplified.ItemFill" Color="#2D3139" />
            <SolidColorBrush x:Key="Surface.Simplified.ItemStroke" Color="#4A5260" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Толщина рамки выделения: одна для рамки жеста и для рамок выбранного. -->
    <x:Double x:Key="Surface.Selection.StrokeThickness">1</x:Double>

    <!--
        Рамка выбранного контейнера ядра. Толщина — Thickness, а не число: её читает
        BorderThickness. Дизайнер интерфейса её не показывает — у него рамки и ручки рисует
        оверлей редактора.
    -->
    <Thickness x:Key="SurfaceItem.SelectionThickness">2</Thickness>

    <!-- Параметры сетки. CellSize задан в мировых единицах, LineThickness — в пикселях устройства. -->
    <x:Double x:Key="Surface.Grid.CellSize">20</x:Double>
    <x:Int32 x:Key="Surface.Grid.MajorInterval">5</x:Int32>
    <x:Double x:Key="Surface.Grid.LineThickness">1</x:Double>
    <x:Double x:Key="Surface.Grid.MinCellSize">6</x:Double>

</ResourceDictionary>

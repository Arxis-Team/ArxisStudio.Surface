<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:surface="clr-namespace:ArxisStudio.Surface">

    <surface:InverseScaleConverter x:Key="Surface.InverseScaleConverter" />
    <surface:ScaleDoubleConverter x:Key="Surface.ScaleDoubleConverter" />

    <!--
        Шаблон ядра: сетка, элементы и рамка выделения во время жеста. Ни ручек, ни
        направляющих — их приносят слои выше; выбранный элемент показывает себя сам,
        своей темой (SurfaceItem.axaml). Слои те же и в том же порядке, что у дизайнера
        форм, поэтому правила про трансформации действуют одинаково: сетка рисует в
        экранных координатах, элементы и рамка — под ViewportTransform.
    -->
    <ControlTheme x:Key="{x:Type surface:SurfaceView}" TargetType="surface:SurfaceView">
        <Setter Property="Background" Value="{DynamicResource Surface.BackgroundBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid>
                        <surface:SurfaceGrid Name="PART_Grid"
                                            ViewportLocation="{TemplateBinding ViewportLocation}"
                                            ViewportZoom="{TemplateBinding ViewportZoom}"
                                            IsVisible="{TemplateBinding ShowGrid}" />

                        <!--
                            Карточки упрощённого вида — под элементами, во весь размер: мир в экран слой
                            переводит сам, как сетка (ADR 0008).
                        -->
                        <surface:SurfaceSimplifiedLayer Name="PART_SimplifiedLayer"
                                                        IsHitTestVisible="False"
                                                        Fill="{DynamicResource Surface.Simplified.ItemFill}"
                                                        Stroke="{DynamicResource Surface.Simplified.ItemStroke}"
                                                        SelectedStroke="{DynamicResource SurfaceItem.SelectionBrush}"
                                                        AccentHeight="{DynamicResource Surface.Item.AccentHeight}" />

                        <Canvas Name="PART_ItemsLayer"
                                RenderTransform="{TemplateBinding ViewportTransform}"
                                RenderTransformOrigin="0,0">
                            <ItemsPresenter Name="PART_ItemsPresenter">
                                <ItemsPresenter.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <surface:VirtualizingSurfacePanel Extent="{Binding ItemsExtent, Mode=OneWayToSource, RelativeSource={RelativeSource AncestorType=surface:SurfaceView}}" />
                                    </ItemsPanelTemplate>
                                </ItemsPresenter.ItemsPanel>
                            </ItemsPresenter>
                        </Canvas>

                        <Canvas Name="PART_InteractionOverlayLayer"
                                IsHitTestVisible="False"
                                RenderTransform="{TemplateBinding ViewportTransform}"
                                RenderTransformOrigin="0,0">
                            <Rectangle Name="PART_Marquee"
                                       Stroke="{DynamicResource Surface.MarqueeStrokeBrush}"
                                       StrokeThickness="{DynamicResource Surface.Selection.StrokeThickness}"
                                       Fill="{DynamicResource Surface.MarqueeFillBrush}"
                                       RenderTransform="{Binding ViewportZoom, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Surface.InverseScaleConverter}}"
                                       RenderTransformOrigin="0,0"
                                       Canvas.Top="{Binding SelectedArea.Y, RelativeSource={RelativeSource TemplatedParent}}"
                                       Canvas.Left="{Binding SelectedArea.X, RelativeSource={RelativeSource TemplatedParent}}"
                                       IsVisible="{TemplateBinding IsSelecting}">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource Surface.ScaleDoubleConverter}">
                                        <Binding Path="SelectedArea.Width" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ViewportZoom" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Rectangle.Width>
                                <Rectangle.Height>
                                    <MultiBinding Converter="{StaticResource Surface.ScaleDoubleConverter}">
                                        <Binding Path="SelectedArea.Height" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="ViewportZoom" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </Rectangle.Height>
                            </Rectangle>
                        </Canvas>

                        <!--
                            Стоп-кадр (ADR 0023): снимок холста поверх всех слоёв, пока хост перестраивает
                            содержимое. Пиксели, а не контролы, — старое содержимое можно отпустить, пока
                            кадр на экране. Показывает и прячет его сам холст.
                        -->
                        <Image Name="PART_FreezeLayer" IsVisible="False" Stretch="Fill" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>

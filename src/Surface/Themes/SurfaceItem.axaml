<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:surface="clr-namespace:ArxisStudio.Surface">

    <!--
        Контейнер ядра. Ручек у ядра нет, поэтому выбранный элемент показывает себя сам —
        рамкой поверх содержимого. Рамка оверлейная, как у контейнера дизайнера интерфейса:
        лежит в той же ячейке и не занимает места, иначе выделение меняло бы размер
        элемента на толщину штриха.

        Фон Transparent, а не пустой: контейнер обязан отвечать на нажатие всей своей
        площадью, и там, где содержимое ничего не рисует, тоже.

        Полоса заголовка — над содержимым, когда задана (ADR 0009): та же, что у карточки
        элемента в упрощённом виде, и той же высоты.
    -->
    <ControlTheme x:Key="{x:Type surface:SurfaceItem}" TargetType="surface:SurfaceItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Background="{TemplateBinding Background}" RowDefinitions="Auto,*">
                    <Border Name="PART_Accent"
                            Height="{DynamicResource Surface.Item.AccentHeight}"
                            Background="{TemplateBinding Accent}"
                            IsVisible="{TemplateBinding Accent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Grid.Row="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}" />
                    <Border Name="PART_SelectionBorder"
                            Grid.RowSpan="2"
                            BorderBrush="{DynamicResource SurfaceItem.SelectionBrush}"
                            BorderThickness="{DynamicResource SurfaceItem.SelectionThickness}"
                            IsHitTestVisible="False"
                            IsVisible="False" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#PART_SelectionBorder">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceItem.HoverBrush}" />
        </Style>

        <Style Selector="^:selected /template/ Border#PART_SelectionBorder">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceItem.SelectionBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Тема ядра: ресурсы поверхности и сетка. Подключается сама по себе редактором,
        которому нужна только поверхность, а дизайнер форм подключает её в своей теме.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ArxisStudio.Surface/Themes/SurfaceResources.axaml" />
        <ResourceInclude Source="avares://ArxisStudio.Surface/Themes/DesignGrid.axaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>

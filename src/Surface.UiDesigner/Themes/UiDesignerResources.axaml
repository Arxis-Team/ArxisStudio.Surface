<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Ресурсы дизайнера интерфейса: контейнер формы, индикатор точки вставки при перестановке и
        индикатор места броска — линия и область (ADR 0024).
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="UiDesigner.ReorderIndicatorBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="UiDesigner.DropIndicatorBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="UiDesigner.DropAreaBrush" Color="#0F6CBD" Opacity="0.12" />

            <SolidColorBrush x:Key="UiDesignerItem.BorderBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="UiDesignerItem.HighlightBrush" Color="#0F6CBD" Opacity="0.16" />

            <SolidColorBrush x:Key="UiDesigner.Form.TitleBar.Background" Color="#F3F3F3" />
            <SolidColorBrush x:Key="UiDesigner.Form.TitleBar.Foreground" Color="#1B1B1B" />
            <SolidColorBrush x:Key="UiDesigner.Form.TitleBar.BorderBrush" Color="#C8C8C8" />

            <SolidColorBrush x:Key="UiDesigner.Form.Fault.Foreground" Color="#B3261E" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="UiDesigner.ReorderIndicatorBrush" Color="#1E90FF" />
            <SolidColorBrush x:Key="UiDesigner.DropIndicatorBrush" Color="#1E90FF" />
            <SolidColorBrush x:Key="UiDesigner.DropAreaBrush" Color="#1E90FF" Opacity="0.16" />

            <SolidColorBrush x:Key="UiDesignerItem.BorderBrush" Color="DodgerBlue" />
            <SolidColorBrush x:Key="UiDesignerItem.HighlightBrush" Color="DodgerBlue" Opacity="0.2" />

            <SolidColorBrush x:Key="UiDesigner.Form.TitleBar.Background" Color="#2B2B2B" />
            <SolidColorBrush x:Key="UiDesigner.Form.TitleBar.Foreground" Color="#F2F2F2" />
            <SolidColorBrush x:Key="UiDesigner.Form.TitleBar.BorderBrush" Color="#4A4A4A" />

            <SolidColorBrush x:Key="UiDesigner.Form.Fault.Foreground" Color="#FF8A80" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="UiDesignerItem.BorderThickness">0</Thickness>

    <!--
        Непрозрачность рамки контейнера в покое. Ноль — рамка видна только при
        наведении, как и было. Больше нуля — контейнер очерчен постоянно, и это
        не стоит ни пикселя раскладки: рамка оверлейная, она рисуется поверх края
        содержимого, а не оборачивает его.
    -->
    <x:Double x:Key="UiDesignerItem.OutlineOpacity">0</x:Double>
    <CornerRadius x:Key="UiDesignerItem.CornerRadius">0</CornerRadius>

    <!--
        Рамка окна у элемента формы (ADR 0020): заголовок над формой, вне границ элемента. Кисти лежат
        в словарях тем, и берёт их рамка под темой формы, а не инструмента: светлое окно носит светлый
        заголовок и в тёмном дизайнере. Название на фоне — 15:1 в светлой и 12:1 в тёмной.
    -->
    <x:Double x:Key="UiDesigner.Form.TitleBar.Height">30</x:Double>
    <x:Double x:Key="UiDesigner.Form.TitleBar.FontSize">12</x:Double>
    <x:Double x:Key="UiDesigner.Form.TitleBar.IconSize">16</x:Double>
    <x:Double x:Key="UiDesigner.Form.TitleBar.ButtonWidth">46</x:Double>
    <x:Double x:Key="UiDesigner.Form.TitleBar.GlyphSize">10</x:Double>
    <Thickness x:Key="UiDesigner.Form.TitleBar.Padding">10,0,0,0</Thickness>
    <Thickness x:Key="UiDesigner.Form.TitleBar.IconMargin">0,0,8,0</Thickness>
    <Thickness x:Key="UiDesigner.Form.TitleBar.BorderThickness">1,1,1,0</Thickness>

    <!--
        Сбой формы (ADR 0028): содержимое упало на замере или раскладке, и на его месте — причина. Текст
        не на холсте, а на карточке хоста, и кисть выбрана читаться на обеих: 6:1 на светлой, 7:1 на тёмной.
    -->
    <Thickness x:Key="UiDesigner.Form.Fault.Margin">12</Thickness>
    <x:Double x:Key="UiDesigner.Form.Fault.FontSize">12</x:Double>

</ResourceDictionary>

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:uidesigner="clr-namespace:ArxisStudio.Surface.UiDesigner">

    <!--
        UiDesignerItem больше не рисует selection frame.
        Его тема отвечает только за content host, hover feedback и toolbar host.
    -->
    <ControlTheme x:Key="{x:Type uidesigner:UiDesignerItem}" TargetType="uidesigner:UiDesignerItem">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="BorderBrush" Value="{DynamicResource UiDesignerItem.BorderBrush}" />

        <Setter Property="BorderThickness" Value="{DynamicResource UiDesignerItem.BorderThickness}" />

        <Setter Property="CornerRadius" Value="{DynamicResource UiDesignerItem.CornerRadius}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="UseLayoutRounding" Value="True" />

        <Setter Property="Template">
            <ControlTemplate>
                <Grid ClipToBounds="False" Background="Transparent">

                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>

                    <Border Name="PART_HoverBorder"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="{DynamicResource UiDesignerItem.OutlineOpacity}" />

                    <StackPanel Name="PART_Toolbar"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-28,0,0"
                                Spacing="2"
                                Opacity="0"
                                IsHitTestVisible="False">
                    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>

        <!--
            ZIndex здесь намеренно не задаётся. Раньше выбранный элемент поднимался
            на 99, чтобы его рамка не перекрывалась соседями, но рамки и ручки давно
            живут на уровне редактора, в PART_SelectionOverlayLayer. Сейчас такой
            подъём молча перебивал бы порядок, заданный BringToFront/SendToBack.
        -->
        <Style Selector="^:selected">
            <Style Selector="^ /template/ StackPanel#PART_Toolbar">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="IsHitTestVisible" Value="True"/>
            </Style>
        </Style>

        <Style Selector="^:pointerover:not(:selected) /template/ Border#PART_HoverBorder">
             <Setter Property="Opacity" Value="1"/>
        </Style>

        <!--
            Загруженная форма не должна жить своей жизнью: кнопка съедала бы
            нажатие, а текстовое поле забирало фокус и принимало текст.
            Выделение от этого не страдает — редактор считает попадание
            по прямоугольникам в мировых координатах, а не через hit-testing,
            и у самого контейнера фон Transparent на всю площадь.
        -->
        <Style Selector="^[ContentMode=Loaded] /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

    </ControlTheme>
</ResourceDictionary>

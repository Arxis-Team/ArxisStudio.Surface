<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../Library.props" />

    <PropertyGroup>
        <RootNamespace>ArxisStudio.Surface.UiDesigner</RootNamespace>
        <Description>Дизайнер интерфейса Avalonia на ArxisStudio.Surface: редактирование загруженной или размеченной разметки, вложенные контролы, стратегии размещения по типу панели, перестановка среди соседей, design-time группы.</Description>
        <PackageTags>avalonia;designer;form-designer;gui-builder;layout-editor;ui</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Surface/ArxisStudio.Surface.csproj" />
        <ProjectReference Include="../Surface.Editing/ArxisStudio.Surface.Editing.csproj" />
    </ItemGroup>

</Project>

<Project>

    <!--
        Общее у трёх библиотек семейства ArxisStudio.Surface (ADR 0003): ядро, инструменты
        редактирования и дизайнер форм. Каждая — отдельная сборка и отдельный пакет,
        а направление ссылок между ними держат ProjectReference: сборка слоя ниже не
        ссылается на слой выше, поэтому ссылку вверх не даст написать компилятор.
    -->
    <PropertyGroup>
        <!-- Avalonia 12 больше не поставляет netstandard2.0-сборки: минимальный TFM — net8.0. -->
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
        Тесты и демо непакуемы — это задано в Directory.Build.props; библиотеки
        включают упаковку здесь.

        Версия 0.x осознанно. Публичная поверхность закреплена слепками, но всё ещё
        меняется — разделение на слои её уже правило, — а 1.0 обещает обратную
        совместимость, которую сейчас обещать нечем.

        Репозиторий переименован вслед за пакетами: ArxisStudio.DesignEditor стал
        ArxisStudio.Surface; прежний адрес GitHub перенаправляет сюда.
    -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <Version>0.1.0</Version>
        <Authors>ArxisStudio</Authors>
        <Company>ArxisStudio</Company>
        <Copyright>Copyright (c) 2026 ArxisStudio</Copyright>
        <Product>ArxisStudio.Surface</Product>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Arxis-Team/ArxisStudio.Surface</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Arxis-Team/ArxisStudio.Surface.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <!--
        Символы отдельным snupkg, а не внутри пакета: иначе .pdb приезжает всем,
        включая тех, кому он не нужен.

        SourceLink с .NET 8 SDK встроен и отдельной ссылки на пакет не требует;
        PublishRepositoryUrl кладёт в сборку адрес репозитория, EmbedUntrackedSources
        добирает файлы, которых нет в git, — без них шаг в такой файл в отладчике
        упирается в ненайденный исходник.
    -->
    <PropertyGroup>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

</Project>

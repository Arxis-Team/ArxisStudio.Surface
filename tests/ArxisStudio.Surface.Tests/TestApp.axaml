<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ArxisStudio.Tests.TestApp"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ArxisStudio.Surface.UiDesigner/Themes/UiDesignerTheme.axaml"/>
                <!-- Ядро и инструменты уже пришли с темой дизайнера интерфейса; от редактора узлов — только его словари. -->
                <ResourceInclude Source="avares://ArxisStudio.Surface.Nodes/Themes/NodesTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

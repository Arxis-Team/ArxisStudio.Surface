<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- xunit v3 собирает тестовый проект как самозапускаемый Exe. -->
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <RootNamespace>ArxisStudio.Tests</RootNamespace>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <!-- Avalonia.Headless.XUnit 12.1.1 завязан на xunit.v3, не на v2. -->
        <PackageReference Include="Avalonia.Headless.XUnit"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <!-- Загрузка .axaml в рантайме: тот же путь, которым пользуется хост-приложение. -->
        <PackageReference Include="Avalonia.Markup.Xaml.Loader"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    </ItemGroup>

    <ItemGroup>
        <!--
            Baseline публичной поверхности читается из встроенного ресурса, а не с диска:
            прогон не должен зависеть от того, где лежат исходники.
        -->
        <EmbeddedResource Include="PublicSurface.*.baseline.txt">
            <LogicalName>ArxisStudio.Tests.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Surface\ArxisStudio.Surface.csproj"/>
        <ProjectReference Include="..\..\src\Surface.Editing\ArxisStudio.Surface.Editing.csproj"/>
        <ProjectReference Include="..\..\src\Surface.UiDesigner\ArxisStudio.Surface.UiDesigner.csproj"/>
    </ItemGroup>
</Project>
